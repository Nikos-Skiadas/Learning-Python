#!/usr/bin/env python3
"""Axiom scorer for the number systems constructed in chapter 1.

Each type built in this chapter (ℕ now; ℤ, ℚ, ... to follow) claims to satisfy a specific
list of axioms from the notes. This script turns that claim into a score: it quantifies
every applicable law over a small sample of values and reports what holds, what fails, and
with which counterexample.

Four kinds of law are scored separately, because failing them means different things:

* **sanity** — the preconditions everything else assumes: that a value can be constructed
  at all, that `repr` returns a string, that the operators hand back values of the type
  rather than `None`. An unfinished implementation, one whose method bodies are still
  `...`, satisfies none of that. These run first so a half-written class scores near zero
  and says why, instead of taking the scorer down with a traceback.
* **axioms** — the definitions the type is *built* from (§1.4.1). A failure here means the
  implementation does not define the object it claims to define.
* **theorems** — consequences that must follow if the axioms are right (commutativity,
  associativity, distributivity). A failure here means the axioms were transcribed in a
  way that does not entail what it should.
* **contracts** — the python-level promises of the class: which operands it accepts, which
  errors it owes the caller. Independent of the mathematics, and the part most easily lost
  while refactoring.

Usage:

	./scorer                       # score every registered type
	./scorer N                     # score one
	./scorer -v                    # several counterexamples per failure, not just the first
	./scorer --help                # the full option list

Exit status is 0 only when every law passes, so this drops straight into a pre-commit hook
or a CI step. The file is executable and deliberately extensionless: it is a command rather
than a module, and there is nothing to install. It resolves the files it scores relative to
its own location, so it works from any working directory.

Registering a new type: write a factory returning a `Spec`, decorate it with
`@register("Z")`, and list the law families that apply in `features`. Everything else —
quantification, reporting, scoring — is shared. The `same` hook exists because structural
`==` on these constructions can be exponential (see the `numbers` module docstring), so a
canonical `repr` is used as the equality oracle and then *validated* against `==` by the
`oracle` family.
"""


from __future__ import annotations


import sys


# `numbers.py` in this directory shadows the standard library's `numbers` module, which
# `fractions`, `decimal` and `statistics` all import. Drop the script's own directory from
# the search path and load targets by explicit file path instead, so that this scorer keeps
# working once ℚ needs `fractions`.
from pathlib import Path


ROOT = Path(__file__).resolve().parent

for _entry in ("", ".", str(ROOT)):
	while _entry in sys.path:
		sys.path.remove(_entry)


import argparse
import importlib.util
import operator

from collections.abc import Callable, Iterable, Iterator, Sequence
from dataclasses import dataclass, field
from itertools import product
from typing import Any


BOLD, DIM, GREEN, RED = "1", "2", "32", "31"

COLOUR = True

VERBOSE = False

COUNTEREXAMPLES = 5


def paint(text: str, *codes: str) -> str:
	"""Wrap `text` in ANSI codes, unless colour has been switched off for this run."""
	if not COLOUR or not codes:
		return text

	return "".join(f"\033[{code}m" for code in codes) + text + "\033[0m"


def show(value: Any) -> str:
	"""`repr`, but never raising, so a malformed `__repr__` cannot derail the report."""
	try:
		return repr(value)
	except Exception as exc:
		return f"<{type(value).__name__} with a broken repr: {type(exc).__name__}>"


def load(filename: str, name: str | None = None) -> Any:
	"""Import a module from this directory by path, bypassing the shadowed name."""
	path = ROOT / filename
	spec = importlib.util.spec_from_file_location(name or f"chapter_{path.stem}", path)

	if spec is None or spec.loader is None:
		raise ImportError(f"cannot load {path}")

	module = importlib.util.module_from_spec(spec)
	spec.loader.exec_module(module)

	return module


@dataclass(frozen=True)
class Result:
	family: str
	law: str
	ok: bool
	kind: str = "axiom"          # axiom | theorem | contract
	detail: str = ""


@dataclass
class Spec:
	"""Everything the shared law families need in order to score one type."""

	name: str                                   # "ℕ  the natural numbers"
	origin: str                                 # "numbers.N"
	source: str                                 # the file under test, for leak detection
	cls: type
	features: frozenset[str]
	embed: Callable[[int], Any]                 # int -> the type under test
	unembed: Callable[[Any], int]               # the type -> int, for agreement checks
	same: Callable[[Any, Any], bool]            # equality oracle
	sample: Sequence[int]                       # values for unary/binary laws
	small: Sequence[int]                        # values for ternary laws
	succ: Callable[[Any], Any] | None = None
	pred: Callable[[Any], Any] | None = None
	normalize: Callable[[Any], Any] | None = None    # operand reader; defaults to `cls`
	spelling: Callable[[Any], str] = repr        # how the type's own repr should read
	bad_operands: Sequence[Any] = ()            # values the operators must refuse
	domain_errors: Sequence[tuple[str, Callable[[], Any], type[BaseException]]] = ()
	order: Callable[[Any, Any], bool] = operator.le

	reflected: bool = False                          # does `int + value` work as well?

	def values(self) -> list[Any]:
		return [self.embed(k) for k in self.sample]

	def smalls(self) -> list[Any]:
		return [self.embed(k) for k in self.small]

	def alike(self, left: Any, right: Any) -> bool:
		"""`same`, except that a value which is not of the type equals nothing at all.

		Every law of the shape "these two expressions agree" would otherwise pass on a
		malformed implementation, because the two sides agree on being `None`. Requiring
		both to be instances first means garbage cannot satisfy an axiom by symmetry. The
		`oracle` family deliberately bypasses this and calls `same` directly, since its job
		is to audit the equality oracle rather than to trust it.
		"""
		if not isinstance(left, self.cls) or not isinstance(right, self.cls):
			return False

		return self.same(left, right)


REGISTRY: dict[str, Callable[[], Spec]] = {}


def register(key: str) -> Callable[[Callable[[], Spec]], Callable[[], Spec]]:
	def decorate(factory: Callable[[], Spec]) -> Callable[[], Spec]:
		REGISTRY[key] = factory
		return factory

	return decorate


# --------------------------------------------------------------------------- probing


def check(family: str, law: str, probe: Callable[[], Any], kind: str = "axiom") -> Result:
	"""Run one law, turning any exception into a failure rather than a crash."""
	try:
		outcome = probe()
	except Exception as exc:                     # a law that explodes has not held
		return Result(family, law, False, kind, f"{type(exc).__name__}: {exc}")

	ok, detail = outcome if isinstance(outcome, tuple) else (bool(outcome), "")

	return Result(family, law, bool(ok), kind, "" if ok else detail)


def forall(cases: Iterable[tuple], predicate: Callable[..., bool]) -> tuple[bool, str]:
	"""True iff `predicate` holds for every case; otherwise where it failed.

	One counterexample is enough to sink a law, so the search stops at the first by default.
	Under `--verbose` it keeps looking and reports up to `COUNTEREXAMPLES`, which is what
	tells "one odd case" apart from "this law simply does not hold here".
	"""
	failures: list[str] = []
	capped = False

	for case in cases:
		where = ", ".join(map(show, case))

		try:
			detail = "" if predicate(*case) else f"at {where}"
		except Exception as exc:
			detail = f"at {where}: {type(exc).__name__}: {exc}"

		if not detail:
			continue

		failures.append(detail)

		if not VERBOSE:
			break

		if len(failures) >= COUNTEREXAMPLES:
			capped = True
			break

	if not failures:
		return True, ""

	return False, "fails " + "; ".join(failures) + ("; ..." if capped else "")


def pairs(seq: Sequence[Any]) -> Iterator[tuple[Any, Any]]:
	return product(seq, repeat=2)


def triples(seq: Sequence[Any]) -> Iterator[tuple[Any, Any, Any]]:
	return product(seq, repeat=3)


# ------------------------------------------------------------------------ law families


def oracle(s: Spec) -> Iterator[Result]:
	"""The equality oracle must agree with the type's own `==` where that is affordable."""
	yield check("oracle", "canonical repr agrees with ==", lambda: forall(
		pairs(s.values()), lambda a, b: s.same(a, b) == (a == b)))
	yield check("oracle", "embedding is injective", lambda: forall(
		pairs(s.sample), lambda j, k: s.same(s.embed(j), s.embed(k)) == (j == k)))
	yield check("oracle", "unembed inverts embed", lambda: forall(
		((k,) for k in s.sample), lambda k: s.unembed(s.embed(k)) == k))
	yield check("oracle", "repr spells the value it embeds", lambda: forall(
		((k,) for k in s.sample), lambda k: repr(s.embed(k)) == s.spelling(k)))


def sanity(s: Spec) -> Iterator[Result]:
	"""Is the implementation even well formed? Checked first, because everything assumes it.

	None of these is a law about numbers. They are the preconditions the actual laws rely
	on, and they exist so that an unfinished class is scored rather than fatal: a method
	body of `...` returns `None`, and `None` propagates into every subsequent law as a
	baffling AttributeError. Failing here means the failures further down are downstream
	noise, so read this section first.
	"""
	kind = "sanity"

	yield check(kind, "zero can be constructed", lambda: (
		isinstance(s.embed(0), s.cls), f"got {type(s.embed(0)).__name__}"), kind)
	yield check(kind, "every sampled value is an instance of the type", lambda: forall(
		((k,) for k in s.sample), lambda k: isinstance(s.embed(k), s.cls)), kind)
	yield check(kind, "repr returns a string", lambda: (
		isinstance(repr(s.embed(0)), str), "repr did not return a str"), kind)
	yield check(kind, "+ returns an instance of the type", lambda: (
		isinstance(s.embed(1) + s.embed(1), s.cls),
		f"got {type(s.embed(1) + s.embed(1)).__name__}"), kind)
	yield check(kind, "· returns an instance of the type", lambda: (
		isinstance(s.embed(1) * s.embed(1), s.cls),
		f"got {type(s.embed(1) * s.embed(1)).__name__}"), kind)

	if (succ := s.succ) is not None:
		yield check(kind, "the successor returns an instance of the type", lambda: (
			isinstance(succ(s.embed(0)), s.cls),
			f"got {type(succ(s.embed(0))).__name__}"), kind)

	if (pred := s.pred) is not None:
		yield check(kind, "the predecessor returns an instance of the type", lambda: (
			isinstance(pred(s.embed(1)), s.cls),
			f"got {type(pred(s.embed(1))).__name__}"), kind)


def peano(s: Spec) -> Iterator[Result]:
	"""The five Peano axioms of §1.4.1."""
	if (succ := s.succ) is not None:
		yield check("peano", "1. 0 is a natural number", lambda: (
			isinstance(s.embed(0), s.cls), f"type is {type(s.embed(0)).__name__}"))
		yield check("peano", "2. σ is closed on the type", lambda: forall(
			((v,) for v in s.values()), lambda v: isinstance(succ(v), s.cls)))
		yield check("peano", "3. 0 is no one's successor", lambda: forall(
			((v,) for v in s.values()), lambda v: not s.alike(succ(v), s.embed(0))))
		yield check("peano", "4. σ is injective", lambda: forall(
			pairs(s.values()), lambda a, b: s.alike(succ(a), succ(b)) == s.alike(a, b)))
		yield check("peano", "5. σ-chain from 0 enumerates the sample (surrogate)", lambda: (
			[s.unembed(v) for v in walk(s.embed(0), succ, len(s.sample))] == list(range(len(s.sample))),
			"iterating σ from 0 does not reproduce 0, 1, 2, ..."))

		if (pred := s.pred) is not None:
			yield check("peano", "σ and its inverse round-trip", lambda: forall(
				((v,) for v in s.values()), lambda v: s.alike(pred(succ(v)), v)))


def walk(start: Any, step: Callable[[Any], Any], count: int) -> list[Any]:
	out, current = [], start

	for _ in range(count):
		out.append(current)
		current = step(current)

	return out


def cardinality(s: Spec) -> Iterator[Result]:
	"""§1.3.2 and §1.4.1: in this construction n is a set of exactly n elements."""
	yield check("cardinality", "n has exactly n elements", lambda: forall(
		((k,) for k in s.sample), lambda k: len(s.embed(k)) == k))
	yield check("cardinality", "the elements of n are 0 .. n-1", lambda: forall(
		((k,) for k in s.sample),
		lambda k: sorted(map(s.unembed, s.embed(k))) == list(range(k))))
	yield check("cardinality", "the elements of n form a ⊆-chain", lambda: forall(
		((k,) for k in s.sample),
		lambda k: all(a <= b or b <= a for a, b in pairs(list(s.embed(k))))))


def addition(s: Spec) -> Iterator[Result]:
	"""The addition axioms of §1.4.1, plus agreement with python's own +.

	Only axiom 2 needs a successor. Guarding the whole family on `s.succ` would make a
	successor-less type score *nothing* here rather than failing, which quietly shrinks the
	denominator and inflates the percentage.
	"""
	yield check("addition", "1. a + 0 = a", lambda: forall(
		((v,) for v in s.values()), lambda v: s.alike(v + s.embed(0), v)))

	if (succ := s.succ) is not None:
		yield check("addition", "2. a + σ(b) = σ(a + b)", lambda: forall(
			pairs(s.values()), lambda a, b: s.alike(a + succ(b), succ(a + b))))

	yield check("addition", "agrees with python's +", lambda: forall(
		pairs(s.sample),
		lambda j, k: s.unembed(s.embed(j) + s.embed(k)) == j + k))
	yield check("addition", "0 + a = a  (needs its own induction)", lambda: forall(
		((v,) for v in s.values()), lambda v: s.alike(s.embed(0) + v, v)), "theorem")


def multiplication(s: Spec) -> Iterator[Result]:
	"""The multiplication axioms of §1.4.1, plus agreement with python's own *.

	As in `addition`, only axiom 2 is guarded on the successor; see the note there.
	"""
	yield check("multiplication", "1. a · 0 = 0", lambda: forall(
		((v,) for v in s.values()), lambda v: s.alike(v * s.embed(0), s.embed(0))))

	if (succ := s.succ) is not None:
		yield check("multiplication", "2. a · σ(b) = a + a · b", lambda: forall(
			pairs(s.values()), lambda a, b: s.alike(a * succ(b), a + a * b)))

	yield check("multiplication", "agrees with python's *", lambda: forall(
		pairs(s.sample),
		lambda j, k: s.unembed(s.embed(j) * s.embed(k)) == j * k))
	yield check("multiplication", "a · 1 = a  (unfolds from the axioms)", lambda: forall(
		((v,) for v in s.values()), lambda v: s.alike(v * s.embed(1), v)), "theorem")
	yield check("multiplication", "1 · a = a  (needs its own induction)", lambda: forall(
		((v,) for v in s.values()), lambda v: s.alike(s.embed(1) * v, v)), "theorem")


def algebra(s: Spec) -> Iterator[Result]:
	"""Consequences that must follow if the axioms above were transcribed correctly."""

	yield check("algebra", "+ is associative", lambda: forall(
		triples(s.smalls()), lambda a, b, c: s.alike((a + b) + c, a + (b + c))), "theorem")
	yield check("algebra", "+ is commutative", lambda: forall(
		pairs(s.values()), lambda a, b: s.alike(a + b, b + a)), "theorem")
	yield check("algebra", "· is associative", lambda: forall(
		triples(s.smalls()), lambda a, b, c: s.alike((a * b) * c, a * (b * c))), "theorem")
	yield check("algebra", "· is commutative", lambda: forall(
		pairs(s.values()), lambda a, b: s.alike(a * b, b * a)), "theorem")
	yield check("algebra", "· distributes over +", lambda: forall(
		triples(s.smalls()), lambda a, b, c: s.alike(a * (b + c), a * b + a * c)), "theorem")
	yield check("algebra", "0 · a = 0  (the left annihilator)", lambda: forall(
		((v,) for v in s.values()), lambda v: s.alike(s.embed(0) * v, s.embed(0))), "theorem")


def order(s: Spec) -> Iterator[Result]:
	"""§1.4.1: a ≤ b iff some c has a + c = b, and that relation is a total order."""
	le = s.order

	yield check("order", "reflexive", lambda: forall(
		((v,) for v in s.values()), lambda v: le(v, v)))
	yield check("order", "antisymmetric", lambda: forall(
		pairs(s.values()), lambda a, b: not (le(a, b) and le(b, a)) or s.alike(a, b)))
	yield check("order", "transitive", lambda: forall(
		triples(s.smalls()),
		lambda a, b, c: not (le(a, b) and le(b, c)) or le(a, c)))
	yield check("order", "total", lambda: forall(
		pairs(s.values()), lambda a, b: le(a, b) or le(b, a)))
	yield check("order", "a ≤ b iff ∃c, a + c = b", lambda: forall(
		pairs(s.values()),
		lambda a, b: le(a, b) == any(s.alike(a + c, b) for c in s.values())))

	if (succ := s.succ) is not None:
		yield check("order", "σ is strictly increasing", lambda: forall(
			((v,) for v in s.values()), lambda v: le(v, succ(v)) and not s.alike(v, succ(v))))


def coercion(s: Spec) -> Iterator[Result]:
	"""A python int on the right of an operator must behave as its embedding."""
	yield check("coercion", "a + int(k) = a + embed(k)", lambda: forall(
		pairs(s.sample),
		lambda j, k: s.alike(s.embed(j) + k, s.embed(j) + s.embed(k))), "contract")
	yield check("coercion", "a · int(k) = a · embed(k)", lambda: forall(
		pairs(s.sample),
		lambda j, k: s.alike(s.embed(j) * k, s.embed(j) * s.embed(k))), "contract")
	read = s.normalize or s.cls

	yield check("coercion", "reading an existing value is the identity", lambda: forall(
		((v,) for v in s.values()), lambda v: s.alike(read(v), v)), "contract")
	yield check("coercion", "reading is idempotent", lambda: forall(
		((v,) for v in s.values()), lambda v: s.alike(read(read(v)), read(v))), "contract")

	if s.reflected:
		yield check("coercion", "int(k) + a = embed(k) + a", lambda: forall(
			pairs(s.sample),
			lambda j, k: s.alike(j + s.embed(k), s.embed(j) + s.embed(k))), "contract")
		yield check("coercion", "int(k) · a = embed(k) · a", lambda: forall(
			pairs(s.sample),
			lambda j, k: s.alike(j * s.embed(k), s.embed(j) * s.embed(k))), "contract")


def contracts(s: Spec) -> Iterator[Result]:
	"""Operand typing and declared errors: the promises the class makes to callers."""
	for bad in s.bad_operands:
		for label, op in (("+", operator.add), ("·", operator.mul)):
			yield check(
				"contracts",
				f"a {label} {bad!r} is refused",
				lambda bad=bad, op=op: refuses(op, s.embed(1), bad, s),
				"contract",
			)

	for label, thunk, expected in s.domain_errors:
		yield check(
			"contracts",
			label,
			lambda thunk=thunk, expected=expected: raises(thunk, expected),
			"contract",
		)


def refuses(op: Callable[[Any, Any], Any], value: Any, bad: Any, spec: Spec) -> tuple[bool, str]:
	"""An unsupported operand must be refused by python's dispatch, not by a leaked error.

	Returning `NotImplemented` hands the decision back to the interpreter, which then either
	tries the reflected operation or raises "unsupported operand type(s)". Either outcome is
	correct, and the wording differs: `N * "x"` legitimately ends up in `str.__rmul__` and
	complains about multiplying a sequence. What must *not* happen is an error escaping from
	inside the type's own code, so the test is where the traceback has been rather than what
	it says.

	The left operand is validated before anything is attempted, because otherwise this check
	passes for the wrong reason. A malformed implementation whose constructor hands back
	`None` makes `None + "x"` raise a TypeError from nowhere near the type under test, which
	looks exactly like a correct refusal. A law that cannot be tested is a failure, not a
	pass.
	"""
	if not isinstance(value, spec.cls):
		return False, (
			f"cannot be tested: the left operand came back as {type(value).__name__}, "
			f"not {spec.cls.__name__}"
		)

	try:
		outcome = op(value, bad)
	except TypeError as exc:
		trace = exc.__traceback__

		while trace is not None:
			if trace.tb_frame.f_code.co_filename == spec.source:
				return False, f"error leaked from {spec.source.rsplit('/', 1)[-1]}: {exc}"

			trace = trace.tb_next

		return True, ""
	except Exception as exc:
		return False, f"{type(exc).__name__} instead of TypeError: {exc}"

	return False, f"no error at all, returned {show(outcome)}"


def raises(thunk: Callable[[], Any], expected: type[BaseException]) -> tuple[bool, str]:
	try:
		outcome = thunk()
	except expected:
		return True, ""
	except Exception as exc:
		return False, f"{type(exc).__name__} instead of {expected.__name__}: {exc}"

	return False, f"no {expected.__name__}, returned {outcome!r}"


FAMILIES: dict[str, Callable[[Spec], Iterator[Result]]] = {
	"sanity": sanity,
	"oracle": oracle,
	"peano": peano,
	"cardinality": cardinality,
	"addition": addition,
	"multiplication": multiplication,
	"algebra": algebra,
	"order": order,
	"coercion": coercion,
	"contracts": contracts,
}


# ------------------------------------------------------------------------------ types


@register("N")
def naturals() -> Spec:
	module = load("numbers.py")
	N = module.N

	return Spec(
		name="ℕ  the natural numbers",
		origin="numbers.N",
		source=module.__file__,
		cls=N,
		features=frozenset(FAMILIES),
		embed=N,
		unembed=len,
		same=lambda a, b: repr(a) == repr(b),
		sample=range(7),
		small=range(4),
		succ=lambda v: v.next,
		pred=lambda v: v.prev,
		reflected=True,
		bad_operands=("x", 2.0, 0.0, None, []),
		domain_errors=(
			("N(-1) rejects a negative int", lambda: N(-1), ValueError),
			("N(0).prev rejects zero", lambda: N().prev, ValueError),
		),
	)


# ---------------------------------------------------------------------------- scoring


def score(spec: Spec) -> list[Result]:
	"""Run every applicable family, surviving a family that cannot run at all.

	`check` already turns a failing law into a `Result`, but a family is a generator and its
	setup code runs on first iteration — outside any `check`. A malformed implementation used
	to abort the whole run from there. Now the family's own collapse is recorded as a failure
	and the remaining families still get scored.
	"""
	results: list[Result] = []

	for key, family in FAMILIES.items():
		if key not in spec.features:
			continue

		try:
			for result in family(spec):
				results.append(result)
		except Exception as exc:
			results.append(Result(
				key,
				f"the {key} family could not be scored",
				False,
				"sanity",
				f"{type(exc).__name__}: {exc}",
			))

	return results


def report(spec: Spec, results: list[Result]) -> bool:
	width = max(len(r.law) for r in results) + 2

	print(f"\n{paint(spec.name, BOLD)}   ({spec.origin})")
	print(f"  sample: {list(spec.sample)}   ternary sample: {list(spec.small)}")

	if malformed := [r for r in results if r.kind == "sanity" and not r.ok]:
		print(
			f"  {paint('malformed', RED)}: {len(malformed)} sanity check(s) failed, so this "
			f"implementation is\n  incomplete or ill-typed and most failures below follow "
			f"from that rather than\n  from the mathematics. Read the sanity section first."
		)

	shown = ""
	for result in results:
		if result.family != shown:
			shown = result.family
			print(f"\n  {paint(shown, DIM)}")

		mark = paint("✔", GREEN) if result.ok else paint("✗", RED)
		tag = "" if result.kind == "axiom" else paint(f"[{result.kind}]", DIM)
		print(f"    {mark} {result.law:<{width}} {tag}".rstrip())

		if not result.ok and result.detail:
			print(f"        {paint(result.detail, RED)}")

	print()
	total_ok = 0
	for kind, label in (("sanity", "sanity"), ("axiom", "axioms"),
	                    ("theorem", "theorems"), ("contract", "contracts")):
		group = [r for r in results if r.kind == kind]

		if not group:
			continue

		ok = sum(r.ok for r in group)
		total_ok += ok
		mark = paint("✔", GREEN) if ok == len(group) else paint("✗", RED)
		print(f"  {label:<12} {ok:>3}/{len(group):<3} {100 * ok // len(group):>3}%  {mark}")

	pct = 100 * total_ok // len(results)
	perfect = total_ok == len(results)
	verdict = paint("valid", GREEN) if perfect else paint("incomplete", RED)
	print(f"  {'─' * 30}\n  {'total':<12} {total_ok:>3}/{len(results):<3} {pct:>3}%  {verdict}")

	return perfect


def main(argv: Sequence[str] | None = None) -> int:
	parser = argparse.ArgumentParser(
		prog=Path(__file__).name,
		description="Score a number system against the axioms it claims to satisfy.",
		epilog="Exit status is 0 only when every law passes.",
	)
	parser.add_argument(
		"types",
		nargs="*",
		choices=list(REGISTRY),
		metavar="TYPE",
		help=f"type(s) to score; defaults to all of: {', '.join(REGISTRY)}",
	)
	parser.add_argument(
		"-v",
		"--verbose",
		action="store_true",
		help=f"report up to {COUNTEREXAMPLES} counterexamples per failing law, not just the first",
	)
	parser.add_argument(
		"--colour",
		"--color",
		choices=("auto", "always", "never"),
		default="auto",
		help="colourise the report; auto (the default) means only when stdout is a terminal",
	)

	args = parser.parse_args(argv)

	global COLOUR, VERBOSE
	COLOUR = args.colour == "always" or (args.colour == "auto" and sys.stdout.isatty())
	VERBOSE = args.verbose

	perfect = True
	for key in args.types or REGISTRY:
		spec = REGISTRY[key]()
		perfect &= report(spec, score(spec))

	return 0 if perfect else 1


if __name__ == "__main__":
	raise SystemExit(main())
