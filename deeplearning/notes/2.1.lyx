\begin_layout Description
\begin_inset Formula $\boldsymbol{\mathbb{C},+}$
\end_inset

:
 Is a field.
\end_layout

\end_deeper
\begin_layout Subsection
Vector spaces
\end_layout

\begin_layout Definition
A set 
\begin_inset Formula $V$
\end_inset

 with respect to a field 
\begin_inset Formula $\mathbb{F}$
\end_inset

 such that:
\end_layout

\begin_deeper
\begin_layout Description
addition:
 
\begin_inset Formula $\exists+:V\times V\rightarrow V$
\end_inset

 such that 
\begin_inset Formula $V$
\end_inset

 is an abelian group,
\end_layout

\begin_layout Description
scalar
\begin_inset space ~
\end_inset

(distributive)
\begin_inset space ~
\end_inset

multiplication:
 
\begin_inset Formula $\exists\cdot:\mathbb{F}\times V\longrightarrow V$
\end_inset

 such that:
\end_layout

\begin_deeper
\begin_layout Description
scalar
\begin_inset space ~
\end_inset

distributivity:
 
\begin_inset Formula $\forall a,b\in\mathbb{F}$
\end_inset

 and 
\begin_inset Formula $\forall\boldsymbol{x}\in V$
\end_inset

,
 
\begin_inset Formula $(a+b)\boldsymbol{x}=a\boldsymbol{x}+b\boldsymbol{x}$
\end_inset

,
\end_layout

\begin_layout Description
vector
\begin_inset space ~
\end_inset

distributivity:
 
\begin_inset Formula $\forall a\in\mathbb{F}$
\end_inset

 and 
\begin_inset Formula $\forall\boldsymbol{x},\boldsymbol{y}\in V$
\end_inset

,
 
\begin_inset Formula $a(\boldsymbol{x}+\boldsymbol{y})=a\boldsymbol{x}+a\boldsymbol{y}$
\end_inset

,
\end_layout

\begin_layout Description
weak
\begin_inset space ~
\end_inset

associativity:
 
\begin_inset Formula $\forall a,b\in\mathbb{F}$
\end_inset

 and 
\begin_inset Formula $\forall\boldsymbol{x}\in V$
\end_inset

,
 
\begin_inset Formula $(ab)\boldsymbol{x}=a(b\boldsymbol{x})=ab\boldsymbol{x}$
\end_inset

,
\end_layout

\begin_layout Description
identity:
 
\begin_inset Formula $\exists!1\in\mathbb{F}$
\end_inset

,
 
\begin_inset Formula $\forall\boldsymbol{x}\in V$
\end_inset

,
 
\begin_inset Formula $1\boldsymbol{x}=\boldsymbol{x}$
\end_inset

,
\end_layout

\end_deeper
\end_deeper
\begin_layout Definition
is called a 
\emph on
vector space
\emph default
 (over a field 
\begin_inset Formula $\mathbb{F}$
\end_inset

).
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Standard
Note that:
\end_layout

\begin_layout Itemize
Both 
\begin_inset Formula $0\in\mathbb{F}$
\end_inset

 and 
\begin_inset Formula $\boldsymbol{0}\in V$
\end_inset

 are destructive with respect to 
\begin_inset Formula $\cdot$
\end_inset

:
\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula $\forall a\in\mathbb{F}$
\end_inset

,
 
\begin_inset Formula $a\boldsymbol{0}=\boldsymbol{0}$
\end_inset

.
\end_layout

\begin_layout Itemize
\begin_inset Formula $\forall\boldsymbol{x}\in V$
\end_inset

,
 
\begin_inset Formula $0\boldsymbol{x}=\boldsymbol{0}$
\end_inset

.
\end_layout

\begin_layout Itemize
\begin_inset Formula $\forall a\in\mathbb{F}$
\end_inset

 and 
\begin_inset Formula $\forall\boldsymbol{x}\in V$
\end_inset

,
 if 
\begin_inset Formula $a\boldsymbol{x}=\boldsymbol{0}$
\end_inset

 then either 
\begin_inset Formula $a=0$
\end_inset

 or 
\begin_inset Formula $\boldsymbol{x}=0$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Itemize
\begin_inset Formula $\forall\boldsymbol{x}\in V$
\end_inset

,
 
\begin_inset Formula $(-1)\boldsymbol{x}=-\boldsymbol{x}$
\end_inset

.
\end_layout

\begin_layout Standard
A field 
\begin_inset Formula $\mathbb{F}$
\end_inset

 is (trivially) a vector space over itself.
\end_layout

\begin_layout Standard
A subspace 
\begin_inset Formula $U\leq V$
\end_inset

 is a subset 
\begin_inset Formula $U\subseteq V$
\end_inset

 that is also a vector space over 
\begin_inset Formula $\mathbb{F}$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Definition
Let 
\begin_inset Formula $V$
\end_inset

 be a vector space over a field 
\begin_inset Formula $\mathbb{F}$
\end_inset

 and 
\begin_inset Formula $A=\{\boldsymbol{x}_{1},\ldots,\boldsymbol{x}_{n}\}\subseteq V$
\end_inset

 a finite set of vectors,
 for some 
\begin_inset Formula $n\in\mathbb{N}$
\end_inset

.
 A vector 
\begin_inset Formula $\boldsymbol{y}\in V$
\end_inset

 is a 
\emph on
linear combination
\emph default
 of 
\begin_inset Formula $A$
\end_inset

 if 
\begin_inset Formula $\exists\{a_{1},\ldots,a_{n}\}\subseteq\mathbb{F}$
\end_inset

 such that:
\begin_inset Formula 
\[
\boldsymbol{y}=\sum\nolimits_{i=1}^{n}a_{i}\boldsymbol{x}_{i}
\]

\end_inset


\end_layout

\begin_layout Definition
\begin_inset Formula $\text{span}A\leq V$
\end_inset

 is the smallest subspace containing the vectors 
\begin_inset Formula $A\subseteq V$
\end_inset

.
 It turns out it consists of all possible linear combinations of the vectors in 
\begin_inset Formula $A$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Definition
Let 
\begin_inset Formula $V$
\end_inset

 be a vector space over a field 
\begin_inset Formula $\mathbb{F}$
\end_inset

.
 A finite set of vectors 
\begin_inset Formula $X=\{\boldsymbol{x}_{1},\ldots,\boldsymbol{x}_{n}\}\subseteq V$
\end_inset

 is 
\emph on
linearly independent
\emph default
 if 
\begin_inset Formula $\forall\{a_{1},\ldots,a_{n}\}\subseteq\mathbb{F}$
\end_inset

 linear combination of 
\begin_inset Formula $X$
\end_inset

,
 if
\begin_inset Formula 
\[
\sum\nolimits_{i=1}^{n}a_{i}\boldsymbol{x}_{i}=\boldsymbol{0}
\]

\end_inset

then 
\begin_inset Formula $\forall i\in\mathbb{N}_{n}$
\end_inset

,
 
\begin_inset Formula $a_{i}=0$
\end_inset

.
\end_layout

\begin_layout Definition
If 
\begin_inset Formula $\text{span}X=V$
\end_inset

,
 then 
\begin_inset Formula $X$
\end_inset

 is called a 
\emph on
basis
\emph default
 of 
\begin_inset Formula $V$
\end_inset

.
 Given a basis 
\begin_inset Formula $X$
\end_inset

,
 every vector 
\begin_inset Formula $\boldsymbol{x}\in V$
\end_inset

 has a unique linear combination of 
\begin_inset Formula $X$
\end_inset

.
\end_layout

\begin_layout Definition
\begin_inset Formula $\dim V=\vert X\vert=n$
\end_inset

 is called the (finite) 
\emph on
dimension
\emph default
 of 
\begin_inset Formula $V$
\end_inset

.
\end_layout

\begin_layout Subsection
Linear Maps
\end_layout

\begin_layout Definition
Let 
\begin_inset Formula $V$
\end_inset

 and 
\begin_inset Formula $U$
\end_inset

 be vector spaces over a field 
\begin_inset Formula $\mathbb{F}$
\end_inset

.
 A map 
\begin_inset Formula $f:V\longrightarrow U$
\end_inset

 that respects vector operations,
 meaning that 
\begin_inset Formula $\forall\{a_{1},\ldots,a_{n}\}\subseteq\mathbb{F}$
\end_inset

 and 
\begin_inset Formula $\{\boldsymbol{x}_{1},\ldots,\boldsymbol{x}_{n}\}\subseteq V$
\end_inset

 for some 
\begin_inset Formula $n\in\mathbb{N}$
\end_inset

:
\begin_inset Formula 
\[
f\Big(\sum\nolimits_{i=1}^{\dim V}a_{i}\boldsymbol{x}_{i}\Big)=\sum\nolimits_{i=1}^{\dim V}a_{i}f(\boldsymbol{x}_{i})
\]

\end_inset

is a 
\emph on
linear map
\emph default
.
\end_layout

\begin_layout Standard
Note that a linear map 
\begin_inset Formula $f:V\longrightarrow U$
\end_inset

 preserves the zero vectors as 
\begin_inset Formula $f(\boldsymbol{0}_{V})=\boldsymbol{0}_{U}$
\end_inset

.
 Indeed,
 
\begin_inset Formula $\forall\boldsymbol{x}\in V$
\end_inset

,
 
\begin_inset Formula $f(\boldsymbol{0}_{V})=f(\boldsymbol{x}-\boldsymbol{x})=f(\boldsymbol{x})-f(\boldsymbol{x})=\boldsymbol{0}_{U}$
\end_inset

.
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\{\boldsymbol{v}_{1},\ldots,\boldsymbol{v}_{\dim V}\}\subseteq V$
\end_inset

 a basis and 
\begin_inset Formula $\{\boldsymbol{u}_{1},\ldots,\boldsymbol{u}_{\dim U}\}\subseteq U$
\end_inset

 a basis.
 Let 
\begin_inset Formula $\boldsymbol{y}=f(\boldsymbol{x}\in V)\in U$
\end_inset

 where:
\begin_inset Formula 
\[
\boldsymbol{y}=\sum\nolimits_{j=1}^{\dim U}y_{j}\boldsymbol{u}_{j}\text{ and }\boldsymbol{x}=\sum\nolimits_{i=1}^{\dim V}x_{i}\boldsymbol{v}_{i}
\]

\end_inset

If 
\begin_inset Formula $f$
\end_inset

 is linear:
\begin_inset Formula 
\[
\boldsymbol{y}=f(\boldsymbol{x})=f\Big(\sum\nolimits_{i=1}^{\dim V}x_{i}\boldsymbol{v}_{i}\Big)=\sum\nolimits_{i=1}^{\dim V}x_{i}f(\boldsymbol{v}_{i})
\]

\end_inset

which implies that 
\begin_inset Formula $f$
\end_inset

 is determined by 
\begin_inset Formula $f(\boldsymbol{v}_{i})\in U$
\end_inset

,
 
\begin_inset Formula $\forall i\in\mathbb{N}:$
\end_inset


\begin_inset Formula 
\[
f(\boldsymbol{v}_{i})=\sum\nolimits_{j=1}^{\dim U}a_{ji}\boldsymbol{u}_{j}
\]

\end_inset


\end_layout

\begin_layout Standard
Note that:
\begin_inset Formula 
\[
\sum\nolimits_{j=1}^{\dim U}y_{j}\boldsymbol{u}_{j}=f\Big(\sum\nolimits_{i=1}^{\dim V}x_{i}\boldsymbol{v}_{i}\Big)=\sum\nolimits_{i=1}^{\dim V}x_{i}f(\boldsymbol{v}_{i})=\sum\nolimits_{i=1}^{\dim V}x_{i}\sum\nolimits_{j=1}^{\dim U}a_{ji}\boldsymbol{u}_{j}=\sum\nolimits_{j=1}^{\dim U}\Big(\sum\nolimits_{i=1}^{\dim V}a_{ji}x_{i}\Big)\boldsymbol{u}_{j}
\]

\end_inset

meaning that:
\begin_inset Formula 
\[
y_{j}=f_{j}(\boldsymbol{x})=\sum\nolimits_{i=1}^{\dim V}a_{ji}x_{i}
\]

\end_inset


\end_layout

\begin_layout Proposition
\begin_inset Formula $Let$
\end_inset

 
\begin_inset Formula $f:V\longrightarrow U$
\end_inset

 and 
\begin_inset Formula $g:W\longrightarrow V$
\end_inset

 be linear maps with 
\begin_inset Formula $U$
\end_inset

,
 
\begin_inset Formula $V$
\end_inset

 and 
\begin_inset Formula $W$
\end_inset

 linear spaces over a field 
\begin_inset Formula $\mathbb{F}$
\end_inset

.
 The composition 
\begin_inset Formula $f\circ g:W\longrightarrow U$
\end_inset

 is also linear.
\end_layout

\begin_layout Standard
For given bases in 
\begin_inset Formula $U$
\end_inset

,
 
\begin_inset Formula $V$
\end_inset

 and 
\begin_inset Formula $W$
\end_inset

,
 and 
\begin_inset Formula $A$
\end_inset

,
 
\begin_inset Formula $B$
\end_inset

 and 
\begin_inset Formula $C$
\end_inset

 the matrix representations of 
\begin_inset Formula $f$
\end_inset

,
 
\begin_inset Formula $g$
\end_inset

 and 
\begin_inset Formula $f\circ g$
\end_inset

 respectively:
\begin_inset Formula 
\[
(f\circ g)_{i}(\boldsymbol{x})=f_{i}(g(\boldsymbol{x}))=\sum\nolimits_{j=1}^{\dim V}a_{ij}g_{j}(\boldsymbol{x})=\sum\nolimits_{j=1}^{\dim V}a_{ij}\sum\nolimits_{k=1}^{\dim W}b_{jk}x_{k}=\sum\nolimits_{k=1}^{\dim W}\Big(\sum\nolimits_{j=1}^{\dim V}a_{ij}b_{jk}\Big)x_{k}
\]

\end_inset

The representation 
\begin_inset Formula $C$
\end_inset

 of 
\begin_inset Formula $f\circ g$
\end_inset

 is then:
\begin_inset Formula 
\[
c_{ik}=\sum\nolimits_{j=1}^{\dim V}a_{ij}b_{jk}
\]

\end_inset

which defines the 
\emph on
matrix product
\emph default
.
\end_layout

\begin_layout Example
A change of base on 
\begin_inset Formula $V$
\end_inset

 is also a linear map 
\begin_inset Formula $f:V\longrightarrow V$
\end_inset

.
 Let 
\begin_inset Formula $\{\boldsymbol{a}_{1},\ldots,\boldsymbol{a}_{\dim V}\}\subseteq V$
\end_inset

 and 
\begin_inset Formula $\{\boldsymbol{b}_{1},\ldots,\boldsymbol{b}_{\dim V}\}\subseteq V$
\end_inset

 be bases of 
\begin_inset Formula $V$
\end_inset

.
 Naturally,
 the vectors of the latter are linear combinations of the former.
 
\begin_inset Formula $\forall j\in\mathbb{N}_{\dim V}$
\end_inset

:
\begin_inset Formula 
\[
\boldsymbol{b}_{j}=\sum\nolimits_{i=1}^{\dim V}\boldsymbol{a}_{i}b_{ij}\text{ or }\boldsymbol{a}_{i}=\sum\nolimits_{j=1}^{\dim V}\boldsymbol{b}_{j}a_{ji}
\]

\end_inset

For 
\begin_inset Formula $\boldsymbol{x}\in V$
\end_inset

,
\begin_inset Formula 
\[
\boldsymbol{v}=\sum\nolimits_{j=1}^{\dim V}y_{j}\boldsymbol{b}_{j}=\sum\nolimits_{i=1}^{\dim V}x_{i}\boldsymbol{a}_{i}=\sum\nolimits_{i=1}^{\dim V}x_{i}\sum\nolimits_{j=1}^{\dim V}\boldsymbol{b}_{j}a_{ji}=\sum\nolimits_{j=1}^{\dim V}\Big(\sum\nolimits_{i=1}^{\dim V}a_{ji}x_{i}\big)\boldsymbol{b}_{j}
\]

\end_inset

or
\begin_inset Formula 
\[
y_{j}=\sum\nolimits_{i=1}^{\dim V}a_{ji}x_{i}
\]

\end_inset


\end_layout

\begin_layout Standard
A linear map 
\begin_inset Formula $f:V\longrightarrow V$
\end_inset

 is called an endomorphism.
\end_layout

\begin_layout Definition
Let 
\begin_inset Formula $f:V\longrightarrow U$
\end_inset

 be a linear map.
 The kernel of 
\begin_inset Formula $f$
\end_inset

 is the subspace 
\begin_inset Formula $\ker f\leq V$
\end_inset

 such that,
 
\begin_inset Formula $\forall\boldsymbol{x}\in\ker f$
\end_inset

,
 
\begin_inset Formula $f(\boldsymbol{x})=\boldsymbol{0}_{U}$
\end_inset

.
\end_layout

\begin_layout Definition
The image of 
\begin_inset Formula $f$
\end_inset

 is the 
\emph on
subspace
\emph default
 
\begin_inset Formula $f(V)\leq U$
\end_inset

 such that,
 
\begin_inset Formula $\forall\boldsymbol{y}\in f(V)$
\end_inset

,
 
\begin_inset Formula $\exists\boldsymbol{x}\in V$
\end_inset

 such that 
\begin_inset Formula $f(\boldsymbol{x})=\boldsymbol{y}$
\end_inset

.
\end_layout

\begin_layout Standard
Note that because 
\begin_inset Formula $f(\boldsymbol{0}_{V})=\boldsymbol{0}_{U}$
\end_inset

 (or because 
\begin_inset Formula $\ker f$
\end_inset

 is a vector space),
 
\begin_inset Formula $\boldsymbol{0}_{V}\in\ker f$
\end_inset

 at minimum.
\end_layout

\begin_layout Exercise
Prove that the map 
\begin_inset Formula $f:V\longrightarrow U$
\end_inset

 such that 
\begin_inset Formula $\forall\boldsymbol{x}\in V$
\end_inset

,
 
\begin_inset Formula $f(\boldsymbol{x})=\boldsymbol{0}_{U}$
\end_inset

,
 is linear.
\end_layout

\begin_layout Standard
Indeed,
 
\begin_inset Formula $\forall a,b\in\mathbb{F}$
\end_inset

 and 
\begin_inset Formula $\forall\boldsymbol{x},\boldsymbol{y}\in V$
\end_inset

,
\begin_inset Formula 
\[
af(\boldsymbol{x})+bf(\boldsymbol{y})=a\boldsymbol{0}_{U}+b\boldsymbol{0}_{U}=\boldsymbol{0}_{U}=f(a\boldsymbol{x}+b\boldsymbol{y})
\]

\end_inset


\end_layout

\begin_layout Standard
In the example above,
 
\begin_inset Formula $\text{ker}f=V$
\end_inset

 and 
\begin_inset Formula $\dim f(V)=0$
\end_inset

.
\end_layout

\begin_layout Definition
A linear map 
\begin_inset Formula $f:V\longrightarrow U$
\end_inset

 is:
\end_layout

\begin_deeper
\begin_layout Itemize
is a 
\emph on
monomorphism
\emph default
 (or a one-to-one linear map) if and only if 
\begin_inset Formula $\dim\ker f=0$
\end_inset

.
\end_layout

\begin_layout Itemize
is an 
\emph on
epimorphism
\emph default
 (or an onto 
\begin_inset Formula $U$
\end_inset

 linear map) if and only if 
\begin_inset Formula $f(V)=U$
\end_inset

.
\end_layout

\begin_layout Itemize
is an 
\emph on
isomporphism
\emph default
 when it is both a monomorphism and an epimorphism.
\end_layout

\end_deeper
\begin_layout Definition
If 
\begin_inset Formula $U=V$
\end_inset

,
 then 
\begin_inset Formula $f$
\end_inset

 is:
\end_layout

\begin_deeper
\begin_layout Itemize
is an 
\emph on
endomorphism
\emph default
.
\end_layout

\begin_layout Itemize
is an 
\emph on
automorphism
\emph default
 if and only if it is also an isomorphism.
\end_layout

\end_deeper
\begin_layout Standard
In general 
\begin_inset Formula $\dim V=\dim\ker f+\dim f(V)$
\end_inset

:
\end_layout

\begin_layout Itemize
For an epimorphism 
\begin_inset Formula $f:V\longrightarrow U$
\end_inset

,
 
\begin_inset Formula $\dim V\geq\dim U$
\end_inset

 and in particular 
\begin_inset Formula $\dim V=\dim\ker f-\dim U$
\end_inset


\end_layout

\begin_layout Itemize
For a monomorphism 
\begin_inset Formula $f:V\longrightarrow U$
\end_inset

,
 
\begin_inset Formula $\dim\ker f=0$
\end_inset

 implying 
\begin_inset Formula $\dim V=\dim f(V)$
\end_inset

.
\end_layout

\begin_layout Itemize
For an isomporphism then,
 where 
\begin_inset Formula $f(V)=U$
\end_inset

,
 
\begin_inset Formula $\dim V=\dim U$
\end_inset

.
\end_layout

\begin_layout Standard
The dimension expressed above have terms:
\end_layout

\begin_layout Itemize
\begin_inset Formula $\text{nullity}f=\dim\ker f$
\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula $\text{rank}f=\dim f(V)\leq\dim U$
\end_inset


\end_layout

\begin_layout Standard
Therefore 
\begin_inset Formula $\dim V=\text{nullity}f+\text{rank}f$
\end_inset

.
\end_layout

\begin_layout Subsection
Decompositions
\end_layout

\begin_layout Subsubsection
Endomosphisms
\end_layout

\begin_layout Standard
Every linear map 
\begin_inset Formula $f:V\longrightarrow U$
\end_inset

 given bases on 
\begin_inset Formula $V$
\end_inset

 and 
\begin_inset Formula $U$
\end_inset

 respectively is represented by a 
\begin_inset Formula $\dim U\times\dim V$
\end_inset

 matrix 
\begin_inset Formula $A$
\end_inset

.
 In matrix form we write
\begin_inset Formula 
\[
f(\boldsymbol{x})=A\boldsymbol{x}
\]

\end_inset

Given another linear map 
\begin_inset Formula $g:W\longrightarrow V$
\end_inset

 with matrix representation 
\begin_inset Formula $B$
\end_inset

,
 the composition is computed by the matrix product:
\begin_inset Formula 
\[
f\circ g:W\longrightarrow U:(f\circ g)(x)=f(g(x))=f(Bx)=ABx
\]

\end_inset


\end_layout

\begin_layout Standard
Square matrices are important because they are used to express endomorphisms 
\begin_inset Formula $f:V\longrightarrow V$
\end_inset

 (or more generally to linear maps 
\begin_inset Formula $f:V\longrightarrow U$
\end_inset

 with 
\begin_inset Formula $\dim V=\dim U$
\end_inset

).
\end_layout

\begin_layout Standard
Note that the set of square matrices (endomophisms) of size 
\begin_inset Formula $\dim V\in\mathbb{N}$
\end_inset

 is an abelian group with matrix addition and a monoid with matrix multiplication (composition).
 The unit square matrix corresponds to the identity map:
\begin_inset Formula 
\[
\text{id}_{V}:V\longrightarrow V:\boldsymbol{x}\mapsto\text{id}_{V}(\boldsymbol{x})=\boldsymbol{x}
\]

\end_inset


\end_layout

\begin_layout Theorem
If the endomorphism 
\begin_inset Formula $f:V\longrightarrow V$
\end_inset

 is either a monomorphism or an epimorphism,
 then it is an isomorphism (automorphism).
\end_layout

\begin_layout Proof
Indeed,
 for endomorphisms it holds as well 
\begin_inset Formula $\dim V=\dim\ker f+\dim f(V)$
\end_inset

.
\end_layout

\begin_deeper
\begin_layout Itemize
If 
\begin_inset Formula $f$
\end_inset

 is a monomorphism,
 then 
\begin_inset Formula $\dim\ker f=0$
\end_inset

,
 therefore 
\begin_inset Formula $\dim V=\dim f(V)$
\end_inset

.
 Because 
\begin_inset Formula $f(V)\leq V$
\end_inset

,
 
\begin_inset Formula $f(V)=V$
\end_inset

 and therefore 
\begin_inset Formula $f$
\end_inset

 is an epimorphism as well.
\end_layout

\begin_layout Itemize
If 
\begin_inset Formula $f$
\end_inset

 is a epimorphism,
 
\begin_inset Formula $\dim V=\dim f(V)$
\end_inset

,
 therefore 
\begin_inset Formula $\dim\ker f=0$
\end_inset

,
 therefore 
\begin_inset Formula $f$
\end_inset

 is a monomorphism too.
\end_layout

\end_deeper
\begin_layout Definition
Every automorphism 
\begin_inset Formula $f:V\longrightarrow V$
\end_inset

 has an inverse 
\begin_inset Formula $f^{-1}:V\longrightarrow V$
\end_inset

 such that
\begin_inset Formula 
\[
f\circ f^{-1}=f^{-1}\circ f=\text{id}_{V}
\]

\end_inset


\end_layout

\begin_layout Standard
That means that the set of invertible square matrices (automophisms) of size 
\begin_inset Formula $\dim V\in\mathbb{N}$
\end_inset

 is a group with matrix multiplication (composition).
 Note that this group is non-abelian!
 In general the matrix product is non-commutiative,
 
\begin_inset Formula $\forall A,B$
\end_inset

 matrices:
\begin_inset Formula 
\[
AB\neq BA
\]

\end_inset

This still holds even for square matrices (endomorphisms).
 For square matrices,
 the commutator is:
\begin_inset Formula 
\[
[A,B]=AB-BA
\]

\end_inset


\end_layout

\begin_layout Definition
Given an endomorphism 
\begin_inset Formula $f:V\longrightarrow V$
\end_inset

 on a vector space 
\begin_inset Formula $V$
\end_inset

 on a field 
\begin_inset Formula $\mathbb{F}$
\end_inset

,
 
\begin_inset Formula $\lambda\in\mathbb{F}$
\end_inset

 is an 
\emph on
eigenvalue
\emph default
 of 
\begin_inset Formula $f$
\end_inset

,
 if and only if 
\begin_inset Formula $\exists\boldsymbol{x}\in V$
\end_inset

 
\emph on
eigenvector
\emph default
,
 such that
\begin_inset Formula 
\[
f(\boldsymbol{x})=A\boldsymbol{x}=\lambda\boldsymbol{x}
\]

\end_inset


\end_layout

