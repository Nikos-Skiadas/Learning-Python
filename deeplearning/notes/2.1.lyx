\begin_layout Definition
A set 
\begin_inset Formula $G$
\end_inset

 with an operation 
\begin_inset Formula $\circ:G\times G\longrightarrow G$
\end_inset

 such that:
\end_layout

\begin_deeper
\begin_layout Description
associativity:
 
\begin_inset Formula $\forall a,b,c\in G$
\end_inset

,
 
\begin_inset Formula $(a\circ b)\circ c=a\circ(b\circ c)=a\circ b\circ c$
\end_inset

,
\end_layout

\begin_layout Description
identity:
 
\begin_inset Formula $\exists!e\in G$
\end_inset

 (identity element),
 
\begin_inset Formula $\forall a\in G$
\end_inset

,
 
\begin_inset Formula $a\circ e=e\circ a=a$
\end_inset

,
\end_layout

\begin_layout Description
reciprocal:
 
\begin_inset Formula $\forall a\in G$
\end_inset

,
 
\begin_inset Formula $\exists!\bar{a}\in G$
\end_inset

,
 
\begin_inset Formula $a\circ\bar{a}=\bar{a}\circ a=e$
\end_inset

,
\end_layout

\end_deeper
\begin_layout Definition
is a called a 
\emph on
group
\emph default
.
\end_layout

\begin_layout Definition
If on top:
\end_layout

\begin_deeper
\begin_layout Description
commutativity:
 
\begin_inset Formula $\forall a,b\in G$
\end_inset

,
 
\begin_inset Formula $a\circ b=b\circ a$
\end_inset

,
\end_layout

\end_deeper
\begin_layout Definition
\begin_inset Formula $G$
\end_inset

 is an 
\emph on
abelian
\emph default
 group.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Standard
Note that:
\end_layout

\begin_layout Itemize
The identity 
\begin_inset Formula $e$
\end_inset

 is self-reciprocal,
 
\begin_inset Formula $\bar{e}=e$
\end_inset

.
\end_layout

\begin_layout Itemize
\begin_inset Formula $\forall a\in G$
\end_inset

,
 the reciprocal of 
\begin_inset Formula $\bar{a}$
\end_inset

 is 
\begin_inset Formula $a$
\end_inset

.
\end_layout

\begin_layout Standard
A subsgroup 
\begin_inset Formula $H\leq G$
\end_inset

 is a subset 
\begin_inset Formula $H\subseteq G$
\end_inset

 that is also a group under 
\begin_inset Formula $+$
\end_inset

.
\end_layout

\begin_layout Example
A set 
\begin_inset Formula $G$
\end_inset

 with 
\begin_inset Formula $+$
\end_inset

 is an additive group,
 or with 
\begin_inset Formula $\cdot$
\end_inset

 is a multiplicative group.
\end_layout

