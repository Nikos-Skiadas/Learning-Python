\begin_layout Subsection
Fields
\end_layout

\begin_layout Definition
A set 
\begin_inset Formula $\mathbb{F}$
\end_inset

 with 
\begin_inset Formula $+:\mathbb{F}\times\mathbb{F}\longrightarrow\mathbb{F}$
\end_inset

 and 
\begin_inset Formula $\cdot:\mathbb{F}\times\mathbb{F}\longrightarrow\mathbb{F}$
\end_inset

 such that:
\end_layout

\begin_deeper
\begin_layout Description
addition:
 
\begin_inset Formula $\mathbb{F}$
\end_inset

 with 
\begin_inset Formula $+$
\end_inset

 is an (additive) abelian group with identity 0,
\end_layout

\begin_layout Description
multiplication:
 
\begin_inset Formula $\mathbb{F}_{*}=\mathbb{F}\setminus\{0\}$
\end_inset

 with 
\begin_inset Formula $\cdot$
\end_inset

 is a (multiplicative) abelian group,
 where:
\end_layout

\begin_deeper
\begin_layout Description
distributivity:
 
\begin_inset Formula $\forall a,b,c\in\mathbb{F}$
\end_inset

,
\begin_inset Formula 
\begin{gather*}
a\cdot(b+c)=a\cdot b+a\cdot c\\
(a+b)\cdot c=a\cdot c+b\cdot c
\end{gather*}

\end_inset


\end_layout

\end_deeper
\end_deeper
\begin_layout Definition
is called a 
\emph on
field
\emph default
.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Standard
Note that:
\end_layout

\begin_layout Itemize
\begin_inset Formula $\forall a\in\mathbb{F}$
\end_inset

,
 
\begin_inset Formula $a\cdot0=0\cdot a=0$
\end_inset

.
 The additive identity of fields is also called the 
\emph on
destructive element
\emph default
.
\end_layout

\begin_layout Itemize
\begin_inset Formula $\forall a,b\in\mathbb{F}$
\end_inset

,
 if 
\begin_inset Formula $a\cdot b=0$
\end_inset

 then either 
\begin_inset Formula $a=0$
\end_inset

 or 
\begin_inset Formula $b=0$
\end_inset

.
\end_layout

\begin_layout Itemize
\begin_inset Formula $\forall a\in\mathbb{F},$
\end_inset

 
\begin_inset Formula $(-1)a=-a$
\end_inset

 and 
\begin_inset Formula $\forall b\in\mathbb{F}$
\end_inset

,
 
\begin_inset Formula $-a\cdot b=(-a)\cdot b=a\cdot(-b)$
\end_inset

.
\end_layout

\begin_layout Standard
A subsfield 
\begin_inset Formula $\mathbb{G}\leq\mathbb{F}$
\end_inset

 is a subset 
\begin_inset Formula $\mathbb{G}\subseteq\mathbb{F}$
\end_inset

 that is also a field under 
\begin_inset Formula $+$
\end_inset

 and 
\begin_inset Formula $\cdot$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Example
\begin_inset space ~
\end_inset


\end_layout

\begin_deeper
\begin_layout Description
\begin_inset Formula $\boldsymbol{\mathbb{N},+,\cdot}$
\end_inset

:
 Is not a field,
