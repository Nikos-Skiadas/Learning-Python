{
	"python.testing.unittestEnabled": false, // no `unittest`
	"python.testing.pytestEnabled": true, // yes `pytest`
	"python.testing.pytestArgs": [
    	"-s"
	],

//	indendation:
	"[python]": {
	//	"editor.tabSize": 4, // optional
		"editor.insertSpaces": false, // use tabs
		"editor.detectIndentation": true, // persistently
		"editor.formatOnType": true, // apply tabs intuitively
	},

//	`pylint` exceptions:
	"pylint.args": [
		"--max-line-length=132",
		"--indent-string='\t'",

		"--disable=arguments-differ",
		"--disable=broad-exception-caught",
		"--disable=attribute-defined-outside-init",
		"--disable=invalid-name",
		"--disable=logging-fstring-interpolation",
		"--disable=missing-function-docstring",
		"--disable=missing-class-docstring",
		"--disable=missing-module-docstring",
		"--disable=multiple-statements",
		"--disable=no-else-return",
		"--disable=no-member",
		"--disable=protected-access",
		"--disable=redefined-builtin",
		"--disable=singleton-comparison",
		"--disable=too-few-public-methods",
		"--disable=too-many-ancestors",
		"--disable=ungrouped-imports",
		"--disable=unnecessary-ellipsis",
		"--disable=unreachable",
		"--disable=unspecified-encoding",
		"--disable=unused-argument",
		"--disable=unused-import",
		"--disable=unused-variable",
		"--disable=use-dict-literal",
		"--disable=use-list-literal",
		"--disable=use-implicit-booleaness-not-len",
		"--disable=useless-parent-delegation",
		"--disable=wrong-import-position",
    ],
    "editor.insertSpaces": false,
}